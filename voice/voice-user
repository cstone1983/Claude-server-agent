#!/usr/bin/env python3
"""voice-user: people and API keys for the voice dictation server (VM 113 "voice").

Every API key belongs to one person (user) and one device. The gateway maps the
key to the user and device and passes them to the services as X-VK-User /
X-VK-Device, so learning data is stored per person and survives reinstalls.

  sudo voice-user list
  sudo voice-user add <user> [--name "Display Name"]
  sudo voice-user key <user> --device <name> [--no-qr]   # new key; shows its setup QR
  sudo voice-user qr <key-id> [app|key|url]              # show the setup QR of a key
  sudo voice-user revoke <key-id>
  sudo voice-user sync                                   # rebuild the gateway's key map

Files (root-only): /root/.config/voice/users.tsv, /root/.config/voice/keys.tsv.
Keys are never printed as text; QR codes are shown only on the terminal of
whoever runs this command.
"""
import os, re, secrets, subprocess, sys, datetime

CONF = "/root/.config/voice"
USERS = f"{CONF}/users.tsv"          # user \t display name
KEYS = f"{CONF}/keys.tsv"            # id \t user \t device \t key \t created \t revoked(0/1)
OLD_KEY = f"{CONF}/api-key"          # the first key (before users existed)
NGINX_MAP = "/opt/voice/gateway/key.conf"
BASE_URL = "https://voice.stoneyshome.com/v1/"
STT, CHAT = "Systran/faster-whisper-small.en", "qwen2.5:3b"
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9 _.-]{0,31}$")


def die(msg):
    sys.exit(f"voice-user: {msg}")


def read_tsv(path, cols):
    if not os.path.exists(path):
        return []
    rows = []
    for line in open(path):
        line = line.rstrip("\n")
        if line and not line.startswith("#"):
            parts = line.split("\t")
            rows.append(dict(zip(cols, parts + [""] * (len(cols) - len(parts)))))
    return rows


def write_tsv(path, cols, rows):
    old = os.umask(0o077)
    tmp = path + ".new"
    with open(tmp, "w") as f:
        for r in rows:
            f.write("\t".join(str(r[c]) for c in cols) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    os.umask(old)


UCOLS = ["user", "name"]
KCOLS = ["id", "user", "device", "key", "created", "revoked"]


def load():
    return read_tsv(USERS, UCOLS), read_tsv(KEYS, KCOLS)


def migrate():
    """First run: turn the single existing key into user chris / device Fold7."""
    if os.path.exists(KEYS) or not os.path.exists(OLD_KEY):
        return
    key = open(OLD_KEY).read().strip()
    write_tsv(USERS, UCOLS, [{"user": "chris", "name": "Chris"}])
    write_tsv(KEYS, KCOLS, [{"id": "k1", "user": "chris", "device": "Fold7", "key": key,
                             "created": datetime.date.today().isoformat(), "revoked": "0"}])
    print("migrated the existing key to user 'chris', device 'Fold7' (key id k1)")


def sync():
    """Write the nginx maps (key -> user/device/id) and reload the gateway."""
    users, keys = load()
    active = [k for k in keys if k["revoked"] != "1"]
    lines = ["# Generated by voice-user - do not edit. Maps the API key to user/device.\n"]
    for var, field in (("voice_user", "user"), ("voice_device", "device"), ("voice_key_id", "id")):
        lines.append(f"map $http_authorization ${var} {{\n  default \"\";\n")
        for k in active:
            lines.append(f"  \"Bearer {k['key']}\" \"{k[field]}\";\n")
        lines.append("}\n")
    lines.append("map $voice_user $voice_auth_ok {\n  \"\" 0;\n  default 1;\n}\n")
    old = os.umask(0o077)
    tmp = NGINX_MAP + ".new"
    with open(tmp, "w") as f:
        f.writelines(lines)
    os.chmod(tmp, 0o600)
    os.replace(tmp, NGINX_MAP)
    os.umask(old)
    test = subprocess.run(["docker", "exec", "voice-gateway", "nginx", "-t"], capture_output=True, text=True)
    if test.returncode != 0:
        die("nginx config test failed:\n" + test.stderr)
    subprocess.run(["docker", "exec", "voice-gateway", "nginx", "-s", "reload"], check=True,
                   capture_output=True)
    print(f"gateway updated: {len(active)} active key(s)")


def qr(key_row, mode="app"):
    users, _ = load()
    name = next((u["name"] for u in users if u["user"] == key_row["user"]), key_row["user"])
    payloads = {
        "url": BASE_URL,
        "key": key_row["key"],
        "app": ('{"v":1,"base_url":"%s","api_key":"%s","stt_model":"%s","chat_model":"%s",'
                '"user":"%s","device":"%s"}' % (BASE_URL, key_row["key"], STT, CHAT, name,
                                                 key_row["device"])),
    }
    for m in (["url", "key", "app"] if mode == "all" else [mode]):
        label = {"url": "Base URL", "key": "API key only", "app": "App setup (scan in Voice Keyboard)"}[m]
        print(f"\n{label} - {name} / {key_row['device']} ({key_row['id']}):")
        subprocess.run(["qrencode", "-t", "ansiutf8", "-m", "2"], input=payloads[m].encode(), check=True)
    print("\nClear the screen afterwards:  clear")


def main(argv):
    if os.geteuid() != 0:
        die("run with sudo")
    os.makedirs(CONF, mode=0o700, exist_ok=True)
    migrate()
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__); return
    cmd, args = argv[0], argv[1:]
    users, keys = load()

    if cmd == "list":
        for u in users:
            print(f"{u['user']}  ({u['name']})")
            for k in keys:
                if k["user"] == u["user"]:
                    state = "REVOKED" if k["revoked"] == "1" else "active"
                    print(f"   {k['id']:4s} {k['device']:16s} created {k['created']}  {state}")
    elif cmd == "add":
        if not args or not NAME_RE.match(args[0]) or " " in args[0]:
            die("usage: voice-user add <user> [--name \"Display Name\"] (user: letters/digits/._-)")
        user = args[0].lower()
        name = args[args.index("--name") + 1] if "--name" in args else user.capitalize()
        if any(u["user"] == user for u in users):
            die(f"user '{user}' already exists")
        users.append({"user": user, "name": name})
        write_tsv(USERS, UCOLS, users)
        print(f"added user '{user}' ({name}); create a key with: sudo voice-user key {user} --device <name>")
    elif cmd == "key":
        if not args or "--device" not in args:
            die("usage: voice-user key <user> --device <name> [--no-qr]")
        user, device = args[0].lower(), args[args.index("--device") + 1]
        if not any(u["user"] == user for u in users):
            die(f"no user '{user}' (add it first)")
        if not NAME_RE.match(device):
            die("device name: up to 32 letters/digits/space/._-")
        nums = [int(k["id"][1:]) for k in keys if k["id"][1:].isdigit()]
        row = {"id": f"k{max(nums, default=0) + 1}", "user": user, "device": device,
               "key": secrets.token_hex(32), "created": datetime.date.today().isoformat(), "revoked": "0"}
        keys.append(row)
        write_tsv(KEYS, KCOLS, keys)
        sync()
        print(f"new key {row['id']} for {user} / {device}")
        if "--no-qr" not in args:
            qr(row, "app")
    elif cmd == "qr":
        if not args:
            die("usage: voice-user qr <key-id> [app|key|url|all]")
        row = next((k for k in keys if k["id"] == args[0] and k["revoked"] != "1"), None)
        if not row:
            die(f"no active key '{args[0]}'")
        qr(row, args[1] if len(args) > 1 else "app")
    elif cmd == "revoke":
        if not args:
            die("usage: voice-user revoke <key-id>")
        row = next((k for k in keys if k["id"] == args[0]), None)
        if not row:
            die(f"no key '{args[0]}'")
        row["revoked"] = "1"
        write_tsv(KEYS, KCOLS, keys)
        sync()
        print(f"revoked {row['id']} ({row['user']} / {row['device']}); that device must be set up again")
    elif cmd == "sync":
        sync()
    else:
        die(f"unknown command '{cmd}' (see: voice-user help)")


if __name__ == "__main__":
    main(sys.argv[1:])
